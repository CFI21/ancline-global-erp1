FROM node:22-alpine
WORKDIR /app

ARG ANCLINE_BUILD_COMMIT=unknown
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_OIDC_ISSUER=
ARG NEXT_PUBLIC_OIDC_CLIENT_ID=
ARG NEXT_PUBLIC_OIDC_REDIRECT_URI=
ARG NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT=
ENV ANCLINE_BUILD_COMMIT=${ANCLINE_BUILD_COMMIT}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_OIDC_ISSUER=${NEXT_PUBLIC_OIDC_ISSUER}
ENV NEXT_PUBLIC_OIDC_CLIENT_ID=${NEXT_PUBLIC_OIDC_CLIENT_ID}
ENV NEXT_PUBLIC_OIDC_REDIRECT_URI=${NEXT_PUBLIC_OIDC_REDIRECT_URI}
ENV NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT=${NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT}

COPY package*.json ./
COPY apps/web/package*.json apps/web/
RUN npm install --include=dev

COPY . .
RUN npm run build -w apps/web

ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh","-c","npm run start -w apps/web -- -p ${PORT:-3000} -H 0.0.0.0"]
