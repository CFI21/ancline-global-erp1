generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  CUSTOMER
  SHIPPER
  CONSIGNEE
  AGENT
  CARRIER
  SLOT_PROVIDER
  DEPOT
  TERMINAL
  TRUCKER
  BROKER
  VENDOR
  ANCLINE_BRANCH
}

enum BookingStatus {
  DRAFT
  RATE_REQUESTED
  RATE_RECEIVED
  RATE_APPROVED
  QUOTE_SENT
  CUSTOMER_ACCEPTED
  BOOKING_REQUESTED
  CREDIT_CHECK
  EQUIPMENT_CHECK
  SLOT_CHECK
  AGENT_ACCEPTANCE
  CARRIER_CONFIRMATION
  FINAL_APPROVAL
  CONFIRMED
  OPERATIONAL
  COMPLETED
  FINANCIALLY_CLOSED
  CANCELLED
}

enum FinanceType {
  REVENUE
  COST
}

enum FinanceStatus {
  PLANNED
  WIP
  ACCRUED
  POSTED
  APPROVAL_PENDING
  APPROVED
  PAYABLE
  PAYMENT_SCHEDULED
  PART_PAID
  PAID
  CLEARED
  FINAL
  DISPUTED
  CANCELLED
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  countryCode String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserAccount {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        String
  branchId    String?
  agentId     String?
  customerId  String?
  partyId     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  roles          OrgRole[]
  countryCode    String?
  customerRef    String?   @unique
  registrationRef String?  @unique
  kycStatus      String    @default("NOT_STARTED")
  kycData        Json?
  kycSubmittedAt DateTime?
  kycApprovedAt  DateTime?
  kycApprovedBy  String?
  kycRejectedAt  DateTime?
  kycRejectedBy  String?
  kycRejectionReason String?
  active         Boolean   @default(true)
  customersOwned Booking[] @relation("CustomerBookings")
  agentBookings  Booking[] @relation("AgentBookings")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RateQuote {
  id               String    @id @default(cuid())
  quoteNo          String    @unique
  customerId       String
  trade            String
  equipment        String
  buyRate          Decimal   @db.Decimal(18,2)
  sellRate         Decimal   @db.Decimal(18,2)
  currency         String
  validFrom        DateTime
  validTo          DateTime
  status           String
  source           String?
  carrierCode      String?
  carrierQuoteRef  String?
  termsVersion     String?
  termsAcceptedAt  DateTime?
  termsAcceptedBy  String?
  bookings         Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Booking {
  owningBranchId       String?
  id                   String        @id @default(cuid())
  bookingNo            String        @unique
  businessModel        String        @default("NVOCC")
  bookingChannel       String        @default("INTERNAL")
  shipmentNo           String?
  shipmentStatus       String?       @default("BOOKED")
  consolId             String?
  customerId           String
  customerRef          String?
  producingAgentId     String?
  rateQuoteId          String?
  salesOwner           String?
  operator             String?
  bookingType          String?
  transportMode        String?
  serviceType          String?
  bookingDate          DateTime?
  customerReference    String?
  shipperReference     String?
  carrierBookingNo     String?
  houseBL              String?
  masterBL             String?
  shipper              String?
  consignee            String?
  notifyParty          String?
  origin               String
  destination          String
  placeOfReceipt       String?
  portOfLoading        String?
  portOfDischarge      String?
  placeOfDelivery      String?
  transshipmentPort    String?
  terminal             String?
  polAgent             String?
  podAgent             String?
  etd                  DateTime?
  eta                  DateTime?
  atd                  DateTime?
  ata                  DateTime?
  cyClosing            DateTime?
  siCutoff             DateTime?
  vgmCutoff            DateTime?
  docCutoff            DateTime?
  portCutoff           DateTime?
  carrier              String?
  vesselVoyage         String?
  equipment            String?
  quantity             Int?
  containerOwner       String?
  throughBL            String?
  commodity            String?
  packageCount         Int?
  packageType          String?
  grossWeight          Float?
  netWeight            Float?
  volumeCbm            Float?
  marksNumbers         String?
  hsCode               String?
  cargoDescription     String?
  incoterm             String?
  freightTerms         String?
  currency             String        @default("USD")
  status               BookingStatus @default(DRAFT)
  creditStatus         String?
  slotStatus           String?
  equipmentStatus      String?
  specialCargo         String?
  dgUnNo               String?
  dgImoClass           String?
  dgPackingGroup       String?
  dgProperShippingName String?
  reeferTemperatureC   Float?
  reeferVentilation    Float?
  reeferHumidityPct    Float?
  oogLengthCm          Float?
  oogWidthCm           Float?
  oogHeightCm          Float?
  oogWeightKg          Float?
  cancellationReason   String?
  cancelledAt          DateTime?
  cancelledBy          String?
  notes                String?
  customer             Organization  @relation("CustomerBookings", fields:[customerId], references:[id])
  producingAgent       Organization? @relation("AgentBookings", fields:[producingAgentId], references:[id])
  rateQuote            RateQuote?    @relation(fields:[rateQuoteId], references:[id], onDelete:SetNull)
  consol               Consol?       @relation(fields:[consolId], references:[id], onDelete:SetNull)
  documents            Document[]
  containers           Container[]
  financeLines         FinanceLine[]
  tasks                Task[]
  approvals            Approval[]
  auditEvents          AuditEvent[]
  milestones           ShipmentMilestone[]
  routingLegs          BookingLeg[]
  closeoutChecklist    JobCloseoutChecklist[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([businessModel, bookingChannel])
  @@index([rateQuoteId])
  @@index([customerRef])
  @@index([salesOwner])
  @@index([operator])
  @@index([consolId])
  @@index([shipmentNo])
}

model ShipmentMilestone {
  id          String   @id @default(cuid())
  bookingId   String
  code        String
  label       String
  location    String?
  plannedAt   DateTime?
  actualAt    DateTime?
  status      String   @default("PLANNED")
  source      String?  @default("MANUAL")
  remarks     String?
  booking     Booking  @relation(fields:[bookingId], references:[id], onDelete:Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId, plannedAt])
  @@index([status])
}

model BookingLeg {
  id          String   @id @default(cuid())
  bookingId   String
  sequence    Int
  legType     String   @default("MAIN")
  mode        String   @default("SEA")
  origin      String
  destination String
  carrier     String?
  vessel      String?
  voyage      String?
  terminal    String?
  etd         DateTime?
  eta         DateTime?
  atd         DateTime?
  ata         DateTime?
  status      String   @default("PLANNED")
  remarks     String?
  booking     Booking  @relation(fields:[bookingId], references:[id], onDelete:Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookingId, sequence])
  @@index([bookingId, status])
}

model Document {
  id             String   @id @default(cuid())
  documentNo     String   @unique
  bookingId      String
  type           String
  version        Int      @default(1)
  status         String
  releaseControl String?
  fileKey        String?
  booking        Booking  @relation(fields:[bookingId], references:[id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Container {
  id                     String              @id @default(cuid())
  containerNo            String              @unique
  bookingId              String?
  type                   String
  ownership              String
  status                 String
  location               String?
  sealNo                 String?
  vgm                    Float?
  grossWeight            Float?
  pickupDate             DateTime?
  emptyDepot             String?
  fullReturnTerminal     String?
  equipmentProvider      String?
  allocationRef          String?
  allocationStatus       String?             @default("UNALLOCATED")
  emptyReleaseOrderNo    String?
  emptyReleaseValidUntil DateTime?
  fullGateInAt           DateTime?
  dischargeAt            DateTime?
  deliveryAt             DateTime?
  detentionFreeDays      Int?
  demurrageFreeDays      Int?
  detentionFreeUntil     DateTime?
  demurrageFreeUntil     DateTime?
  emptyReturnDue         DateTime?
  emptyReturnedAt        DateTime?
  detentionRatePerDay    Float?
  demurrageRatePerDay    Float?
  freeTimeCurrency       String?             @default("USD")
  booking                Booking?            @relation(fields:[bookingId], references:[id])
  movements              ContainerMovement[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model ContainerMovement {
  id          String    @id @default(cuid())
  containerId String
  eventCode   String
  eventLabel  String
  status      String?
  location    String?
  occurredAt  DateTime
  source      String    @default("MANUAL")
  reference   String?
  remarks     String?
  actorId     String?
  container   Container @relation(fields:[containerId], references:[id], onDelete:Cascade)
  createdAt   DateTime  @default(now())

  @@index([containerId, occurredAt])
  @@index([eventCode])
}

model FinanceLine {
  id                String        @id @default(cuid())
  bookingId         String
  type              FinanceType
  chargeCode        String
  description       String?
  partyId           String?
  billingPartyId    String?
  serviceProviderId String?
  quantity          Decimal?      @db.Decimal(18,3)
  unitRate          Decimal?      @db.Decimal(18,2)
  amount            Decimal       @db.Decimal(18,2)
  finalAmount       Decimal?      @db.Decimal(18,2)
  currency          String
  status            FinanceStatus @default(PLANNED)
  source            String?
  reference         String?
  taxRate           Decimal?      @db.Decimal(8,4)
  invoiceReady      Boolean       @default(false)
  invoiceNo         String?
  invoiceIssuedAt   DateTime?
  accruedAt         DateTime?
  postedAt          DateTime?
  booking           Booking       @relation(fields:[bookingId], references:[id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId, type])
  @@index([bookingId, status])
  @@index([reference])
}

model Task {
  id        String   @id @default(cuid())
  bookingId String?
  title     String
  ownerId   String?
  dueAt     DateTime?
  status    String
  slaState  String?
  booking   Booking? @relation(fields:[bookingId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id          String   @id @default(cuid())
  bookingId   String?
  type        String
  requesterId String
  approverId  String
  status      String
  reason      String?
  booking     Booking? @relation(fields:[bookingId], references:[id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  bookingId  String?
  actorId    String
  action     String
  objectType String
  objectId   String
  detail     Json?
  booking    Booking? @relation(fields:[bookingId], references:[id])
  createdAt  DateTime @default(now())
}

model IntegrationEvent {
  id           String   @id @default(cuid())
  sourceSystem String
  eventType    String
  externalId   String?
  objectType   String
  objectId     String
  status       String
  payload      Json?
  attemptCount Int      @default(0)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([objectType, objectId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  category   String
  title      String
  message    String
  objectType String?
  objectId   String?
  status     String   @default("UNREAD")
  readAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
  @@index([objectType, objectId])
}

model JobCloseoutChecklist {
  id          String   @id @default(cuid())
  bookingId   String
  itemCode    String
  itemLabel   String
  mandatory   Boolean  @default(true)
  completed   Boolean  @default(false)
  completedBy String?
  completedAt DateTime?
  note        String?
  booking     Booking  @relation(fields:[bookingId], references:[id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookingId, itemCode])
}

model VesselVoyageSchedule {
  id              String   @id @default(cuid())
  scheduleNo      String   @unique
  carrier         String
  serviceName     String?
  vessel          String
  imoNo           String?
  voyage          String
  direction       String?
  portOfLoading   String
  portOfDischarge String
  terminal        String?
  etd             DateTime
  eta             DateTime
  atd             DateTime?
  ata             DateTime?
  cyClosing       DateTime?
  siCutoff        DateTime?
  vgmCutoff       DateTime?
  docCutoff       DateTime?
  capacityTeu     Int?
  status          String   @default("PLANNED")
  source          String   @default("MANUAL")
  remarks         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([carrier, vessel, voyage])
  @@index([portOfLoading, portOfDischarge, etd])
  @@index([status])
}

model TransportOrder {
  id                 String   @id @default(cuid())
  orderNo            String   @unique
  bookingId          String
  containerId        String?
  orderType          String   @default("IMPORT_DELIVERY")
  providerOrgId      String?
  providerName       String?
  driverName         String?
  driverPhone        String?
  truckNo            String?
  trailerNo          String?
  pickupLocation     String
  deliveryLocation   String
  plannedPickupAt    DateTime?
  plannedDeliveryAt  DateTime?
  actualPickupAt     DateTime?
  actualDeliveryAt   DateTime?
  status             String   @default("PLANNED")
  customerReference  String?
  providerReference  String?
  instructions       String?
  proofOfDeliveryRef String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([bookingId, status])
  @@index([containerId])
  @@index([providerOrgId])
  @@index([plannedPickupAt])
}

model Consol {
  id              String    @id @default(cuid())
  consolNo        String    @unique
  mode            String    @default("SEA")
  carrier         String?
  serviceName     String?
  masterBL        String?
  vessel          String?
  voyage          String?
  origin          String
  destination     String
  portOfLoading   String
  portOfDischarge String
  terminal        String?
  etd             DateTime
  eta             DateTime
  atd             DateTime?
  ata             DateTime?
  status          String    @default("PLANNED")
  owningBranchId  String?
  remarks         String?
  createdBy       String?
  shipments       Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([carrier, vessel, voyage])
  @@index([portOfLoading, portOfDischarge, etd])
  @@index([status])
  @@index([owningBranchId])
}

model ServiceContract {
  id              String             @id @default(cuid())
  contractNo      String             @unique
  partyId         String
  partyType       String
  contractType    String
  trade           String?
  currency        String             @default("USD")
  validFrom       DateTime
  validTo         DateTime
  minimumQuantity Decimal?           @db.Decimal(18,2)
  quantityUnit    String?
  status          String             @default("DRAFT")
  notes           String?
  rates           ContractRateLane[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([partyId, status])
  @@index([validTo])
}

model ContractRateLane {
  id                  String          @id @default(cuid())
  contractId          String
  origin              String
  destination         String
  equipment           String
  chargeCode          String
  buyRate             Decimal?        @db.Decimal(18,2)
  sellRate            Decimal?        @db.Decimal(18,2)
  currency            String
  dgPremium           Decimal?        @db.Decimal(18,2)
  reeferPremium       Decimal?        @db.Decimal(18,2)
  oogRule             String?
  freeTimeOrigin      Int?
  freeTimeDestination Int?
  contract            ServiceContract @relation(fields:[contractId], references:[id], onDelete:Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([contractId])
  @@index([origin, destination, equipment])
  @@index([chargeCode, currency])
}
