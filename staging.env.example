NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ancline_staging
REDIS_URL=redis://HOST:6379

# Web runtime proxy target. This is read by the Next.js server at runtime,
# so the same immutable web image can be promoted between environments.
ANCLINE_API_URL=https://api-staging.ancline.net
NEXT_PUBLIC_API_URL=

CORS_ORIGINS=https://erp-staging.ancline.net,https://portal-staging.ancline.net,https://agent-staging.ancline.net

OIDC_ISSUER=https://replace-with-managed-oidc
OIDC_CLIENT_ID=replace
OIDC_CLIENT_SECRET=use-secret-manager
OIDC_REDIRECT_URI=https://erp-staging.ancline.net/auth/callback

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=ancline-staging-documents
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_ACCESS_KEY=use-secret-manager
OBJECT_STORAGE_SECRET_KEY=use-secret-manager

LOG_LEVEL=info
